# Fonte de dados: local (localStorage) | supabase
# local  → seed em src/data/seed/* (limpe carriage:clients / carriage:vehicles para reseed)
# supabase → migrations em supabase/migrations/ (npx supabase db push)
VITE_DATA_SOURCE=local

# Obrigatório quando VITE_DATA_SOURCE=supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY
